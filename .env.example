AIRFLOW_SOURCE_MODE=web
# AIRFLOW_BASE_URL / AIRFLOW_COOKIE_HEADER / AIRFLOW_X_CSRFTOKEN / DAG_ALLOWLIST
# are injected from Streamlit runtime (paste cURL in UI), not persisted in .env.
AIRFLOW_VERIFY_SSL=true
AIRFLOW_USE_CURL_FALLBACK=true
# WEB_MAX_DAGRUNS_PER_DAG=30

COLLECT_DAYS=14
PAGE_LIMIT=1000

DB_URL=sqlite:///airflow_metrics.db
RAW_TABLE=raw_task_instances
FACT_TABLE=fact_airflow_task_run

RAW_CSV_PATH=data/raw_task_instances.csv
FACT_CSV_PATH=data/fact_airflow_task_run.csv
TASK_MAPPING_FILE=task_mapping.yaml

# FastAPI CORS：逗号分隔的前端源（EdgeOne Pages 上线后把正式域名加进来）
# CORS_ORIGINS=https://your-app.pages.dev,http://localhost:5173
